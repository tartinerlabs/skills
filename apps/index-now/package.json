{
  "name": "@tartinerlabs/index-now-mcp",
  "version": "0.12.0",
  "description": "Unofficial Model Context Protocol server for IndexNow URL submission, run locally over stdio.",
  "license": "MIT",
  "type": "module",
  "repository": {
