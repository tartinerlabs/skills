{
  "name": "@tartinerlabs/google-search-console-mcp",
  "version": "1.0.0",
  "description": "Unofficial Model Context Protocol server for Google Search Console, with Sign in with Google (OAuth 2.1 via Better Auth) on Vercel.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "vercel dev --listen $PORT",
    "build": "tsc -p tsconfig.build.json",
    "vercel-build": "turbo run build && pnpm db:migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:generate": "auth generate --output src/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "portless": {
    "name": "gsc.mcp",
    "script": "dev:app"
  },
  "dependencies": {
    "@better-auth/cimd": "catalog:",
    "@googleapis/searchconsole": "11.0.1",
    "@modelcontextprotocol/server": "catalog:",
    "@neon/config": "catalog:",
    "@repo/core": "workspace:*",
    "@vercel/functions": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "google-auth-library": "11.3.0",
    "hono": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vercel/config": "catalog:",
    "auth": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
